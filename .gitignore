# 密钥与环境变量（重要：OpenAI API Key 绝不能进仓库）
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时产物
*.log
logs/
tmp/
.cache/

# 本地提取的样本数据与输出结果（避免把客户数据提交上去）
/data/
/output/
*.local.json
*.local.txt

